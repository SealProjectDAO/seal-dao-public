# /etc/seal/relayer.env — operator-specific environment for
# seal-relayer.service. Copy to /etc/seal/relayer.env, set the
# values for your validator + chain config, chmod 600.
#
# Every key listed in seal-relayer.service's ExecStart must be set
# here, OR the matching --flag must be removed from the unit file
# (e.g. drop the --solana-* flags entirely if this validator only
# relays Stellar withdrawals).

# ── seal-node + relayer loop ────────────────────────────────────

SEAL_RELAYER_NODE_URL=http://127.0.0.1:8545
SEAL_RELAYER_INTERVAL_SECS=10
SEAL_RELAYER_MAX_BACKOFF_SECS=30
# Prometheus /metrics endpoint. Comment the matching --metrics-bind
# line out of seal-relayer.service to disable.
SEAL_RELAYER_METRICS_BIND=127.0.0.1:8548

# ── Stellar (testnet defaults) ──────────────────────────────────

# `stellar keys` identity for the funded G-key the relayer signs as.
SEAL_RELAYER_STELLAR_SOURCE=seal-relayer
# Network alias from `stellar network add` config (testnet | mainnet | local).
SEAL_RELAYER_STELLAR_NETWORK=testnet
# Soroban contract id deployed via `stellar contract deploy`.
SEAL_RELAYER_STELLAR_CONTRACT_ID=CABCDEFGHIJKLMNOPQRSTUVWXYZ234567ABCDEFGHIJKLMN
# Working dir the stellar CLI invokes from (so `.stellar/` config
# resolves consistently). Default mirrors docs/BRIDGE-TESTNET.md.
SEAL_RELAYER_STELLAR_CONTRACT_DIR=/opt/seal/bridges/stellar

# ── Solana (devnet defaults) ────────────────────────────────────

SEAL_RELAYER_SOLANA_PROGRAM_ID=BridgePxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SEAL_RELAYER_SOLANA_CLUSTER=devnet
SEAL_RELAYER_SOLANA_AUTHORITY=AuthorityPubkeyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SEAL_RELAYER_ANCHOR_DIR=/opt/seal/bridges/solana

# Per-token (mint, vault) pairs. WSOL and WUSDC opt in independently.
# To disable a token on this relayer, comment out BOTH lines for the
# pair AND remove the matching --solana-mint-* / --solana-vault-ata-*
# from seal-relayer.service ExecStart.
SEAL_RELAYER_SOLANA_MINT_WSOL=WSOLMintPubkeyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SEAL_RELAYER_SOLANA_VAULT_ATA_WSOL=WSOLVaultATAPubkeyxxxxxxxxxxxxxxxxxxxxxx
SEAL_RELAYER_SOLANA_MINT_WUSDC=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
SEAL_RELAYER_SOLANA_VAULT_ATA_WUSDC=WUSDCVaultATAPubkeyxxxxxxxxxxxxxxxxxxxxx
