target/
# vendor/ is recreated with: ./scripts/vendor-update.sh
# PQC-patched libp2p crates are in patches/ (committed to git)
# vendor/ itself is ~671MB and was not committed
formal/rocq/.Makefile.d
formal/rocq/.lia.cache
formal/rocq/Makefile
formal/rocq/Makefile.conf
formal/rocq/seal_verify/*.vo
formal/rocq/seal_verify/*.vos
formal/rocq/seal_verify/*.vok
formal/rocq/seal_verify/*.glob
formal/rocq/seal_verify/.*.aux
formal/lean/.lake/
formal/lean/lake-manifest.json
_apalache-out/
mykey.json
seal-data
mykem.json
node_modules
testnet-data

# Bridge build artifacts (Anchor + Soroban)
bridges/solana/.anchor/
bridges/solana/programs/*/build-sbf.log
bridges/solana/programs/*/target/
bridges/solana/target/
bridges/stellar/target/
# soroban-sdk 22 auto-generates per-test state snapshots under
# `test_snapshots/`. Regenerated on every `cargo test`; tracking
# would make each test edit a noisy multi-file diff.
bridges/stellar/test_snapshots/
# Stellar CLI per-cwd config + contract-id record from bridge-e2e
# runs. Both are ephemeral artifacts of `./scripts/bridge-e2e.sh`
# (see `deploy_stellar`, which wipes `.stellar/` at the start of
# each run).
.stellar/
**/.stellar/
bridges/.stellar-contract-id
key.json
alice.json
treasury.json
.claude/*.lock
kem.json
dist/
alice.json
bob.json
creator.json
# Compromised BIP-39 wallet (2026-09-28) — never committed; rotate it.
seal-key.json
# Generated bridge-e2e ML-DSA keypair (scripts/bridge-e2e.sh creates it on
# first run); a bare `git add -A` on a dev box would otherwise ship a
# real private key (2026-09-27 inspection §2.3-F).
bridges/.seal-e2e-*

# macOS Finder metadata
.DS_Store
# Vendor crates contain source dirs literally named target/ (cc, gdbstub);
# the top-level target/ pattern above would drop them on git add.
!vendor/*/src/target/
!vendor/*/src/target/**
